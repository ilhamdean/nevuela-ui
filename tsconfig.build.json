{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "composite": false
  },
  "include": ["src/index.ts", "src/components/**/*.ts", "src/components/**/*.vue", "src/lib/**/*.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.mdx"]
}
