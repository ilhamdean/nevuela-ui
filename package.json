{
  "name": "nevuela-ui",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "description": "Nevuela — an original Vue 3 admin-console design system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhamdean/nevuela-ui.git"
  },
  "homepage": "https://github.com/ilhamdean/nevuela-ui#readme",
  "bugs": {
    "url": "https://github.com/ilhamdean/nevuela-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "component-library",
    "tailwindcss",
    "reka-ui",
    "admin",
    "dashboard"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/nevuela.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist && pnpm run build:lib && pnpm run build:types",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json,md}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/addon-themes": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/vue3-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-storybook": "^10.5.3",
    "eslint-plugin-vue": "^10.10.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  }
}
